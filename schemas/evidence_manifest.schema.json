{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Evidence Manifest (adapter)",
  "description": "Optional Artifact/modality metadata adapter for attaching media payloads to process evidence. NOT a generation-model leaderboard contract. Product P0 is trajectory/Judge/gate release-audit — see docs/STATUS.md and docs/ROADMAP.md.",
  "type": "object",
  "required": ["schema_version", "samples"],
  "properties": {
    "schema_version": {
      "const": "multimodal-evidence-manifest/v1",
      "description": "Legacy id kept for fixture compatibility; scope limited to Artifact adaptation."
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "required": [
        "sample_id",
        "modality",
        "input_uri",
        "input_sha256",
        "prediction",
        "reference",
        "source"
      ],
      "properties": {
        "sample_id": { "type": "string", "minLength": 1 },
        "modality": {
          "enum": ["text", "image", "audio", "video", "document"]
        },
        "input_uri": { "type": "string", "minLength": 1 },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "prediction": {},
        "reference": {},
        "source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  }
}
